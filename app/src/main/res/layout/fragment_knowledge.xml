<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gray_light">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="8dp"
        android:background="@drawable/tab_layout_bg"
        android:elevation="4dp"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabTextAppearance="@style/KnowledgeTabTextStyle"
        app:tabSelectedTextColor="@color/primary_green"
        app:tabTextColor="@color/gray_medium"
        app:tabIndicatorColor="@color/primary_green"
        app:tabIndicatorHeight="3dp"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorGravity="bottom"
        app:tabPaddingStart="16dp"
        app:tabPaddingEnd="16dp"
        app:tabContentStart="16dp"
        app:tabRippleColor="@color/primary_green_light"
        app:tabBackground="@android:color/transparent"/>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="8dp"
        android:layout_marginTop="4dp"
        android:background="@android:color/white"
        android:elevation="2dp"
        android:clipToOutline="true"
        android:padding="16dp"/>

</LinearLayout>