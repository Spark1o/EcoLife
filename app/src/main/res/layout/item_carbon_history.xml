<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/item_carbon_bg"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_item_type"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="出行-自驾"
            android:textColor="#2E7D32"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tv_item_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2025-12-27 10:00"
            android:textColor="#757575"
            android:textSize="12sp"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/tv_item_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="数值：100.00 公里"
            android:textColor="#424242"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/tv_item_carbon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="碳排放：25.00 kgCO₂"
            android:textColor="#43A047"
            android:textSize="14sp"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end">

        <TextView
            android:id="@+id/tv_item_edit"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="#E8F5E9"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="编辑"
            android:textColor="#2E7D32"
            android:textSize="12sp"
            android:layout_marginRight="8dp"
            android:radius="14dp"/>

        <TextView
            android:id="@+id/tv_item_delete"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="#FFEBEE"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="删除"
            android:textColor="#E53935"
            android:textSize="12sp"
            android:radius="14dp"/>

    </LinearLayout>

</LinearLayout>