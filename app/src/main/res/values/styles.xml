<resources>
    <!-- 基础应用主题（确保使用Material主题） -->
    <style name="Theme.Eco" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorPrimaryVariant">@color/primary_green_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>
    </style>

    <!-- 自定义Tab文字样式（兼容所有版本） -->
    <style name="TabTextStyle" parent="android:TextAppearance.Widget.TabWidget">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">normal</item>
        <!-- API28+：中等字重（500），低版本自动忽略 -->
        <item name="android:textFontWeight">500</item>
    </style>

    <style name="KnowledgeTabTextStyle" parent="android:TextAppearance">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/gray_medium</item>
        <item name="android:letterSpacing">0.02</item>
    </style>
</resources>