<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- 圆角 -->
    <corners android:radius="12dp"/>
    <!-- 白色背景 -->
    <solid android:color="#FFFFFF"/>
    <!-- 阴影（兼容Android 9+） -->
    <padding
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="2dp"/>
    <stroke
        android:width="1dp"
        android:color="#E0E0E0"/>
</shape>